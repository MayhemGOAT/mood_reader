# Genius — https://genius.com/api-clients
# IMPORTANT: use "Client Access Token" only (not Client ID / Client Secret)
GENIUS_ACCESS_TOKEN=

# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm (optional) — https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Kaggle — https://www.kaggle.com/settings → API → Generate New Token
KAGGLE_API_TOKEN=

# Legacy Kaggle auth (optional; only if you use "Create Legacy API Key")
# KAGGLE_USERNAME=
# KAGGLE_KEY=


# Skip heavy HuggingFace emotion model during dev
# MOOD_READER_FAST=1
